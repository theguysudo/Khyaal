# Google OAuth for the family login page (/login)
# 1. console.cloud.google.com → APIs & Services → OAuth consent screen (External, add yourself as test user)
# 2. Credentials → OAuth client ID → Web application
# 3. Authorized redirect URIs — Google REJECTS IP-address callbacks, so only
#    register the loopback one:
#      http://localhost:3100/api/auth/google/callback
#      http://127.0.0.1:3100/api/auth/google/callback
#    A phone on the LAN cannot complete Google's redirect — use the
#    session-transfer link on /login ("Open on her phone") instead.
# 4. Paste the client id + secret here and restart the server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: fixed session signing key (auto-generated in .session-secret otherwise)
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Free LLM providers — used by "Ask Khayaal" and the behaviour analysis.
# The backend proxies every call, so the Android app never holds a key.
# All three are optional; the server falls back through the others.
# ---------------------------------------------------------------------------

# NVIDIA NIM — https://build.nvidia.com → get an API key (free tier).
# Base: https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_API_KEY=

# OpenRouter — https://openrouter.ai/keys (free models).
# Also serves MiniMax: minimaxai/minimax-m3.1-flash
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Optional alerting channels. Each is a silent no-op without its credentials.
# ---------------------------------------------------------------------------

# Firebase (Spark plan is free) — FCM push and the Firestore store.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Or the whole service account as one JSON blob:
# FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"..."}

# Web push (VAPID) — generated into .env.local by the setup guide.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:hello@khayaal.care

# SMTP — email to the care circle on a tier-3 alert.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
