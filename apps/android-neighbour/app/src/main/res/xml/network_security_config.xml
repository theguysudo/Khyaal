<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is permitted ONLY so the demo app can talk to a local backend
  (http://10.0.2.2:3100 on the emulator, or a laptop's LAN address).
  For production, set cleartextTrafficPermitted="false" — the release
  default base URL is already https://khayaal.example/.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
