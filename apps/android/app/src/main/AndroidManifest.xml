<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network: the only way signals leave the phone. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Passive signal collection. Never ACCESS_FINE_LOCATION, never GPS. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Care notifications, kept alive across reboots, full-screen for tier 3. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Night watch (opt-in, default OFF): a microphone foreground service that
         classifies loudness on-device. No audio ever leaves the phone or touches
         disk — only the resulting event (quiet / noise / loud) is posted. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Tier-3 call chain: place calls directly when granted. Without it the
         app falls back to ACTION_DIAL (dialer opens, she presses call). -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Optional app-open signals (package names only, never screen content).
         A protected AppOps permission — the user grants it in Settings. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".KhayaalApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Khayaal">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Khayaal">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Re-arm periodic signal flush + state poll after a reboot. -->
        <receiver
            android:name=".signals.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Activity-recognition transitions arrive via a PendingIntent broadcast. -->
        <receiver
            android:name=".signals.MotionTransitionReceiver"
            android:exported="false" />

        <!-- Notification action buttons ("I'm OK" / "Snooze 1h"). -->
        <receiver
            android:name=".care.CheckInActionReceiver"
            android:exported="false" />

        <!-- Night watch: opt-in mic foreground service. Loudness is classified
             on-device; nothing is recorded, stored or uploaded. -->
        <service
            android:name=".sleep.SleepWatchService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- "Hey Khayaal": opt-in on-device speech recognition for a few
             voice commands. No audio stored; transcripts stay in memory. -->
        <service
            android:name=".voice.VoiceCommandService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Call-chain notification's Cancel button. -->
        <receiver
            android:name=".care.CallChainActionReceiver"
            android:exported="false" />

        <!-- FCM stub: instant tier pushes on top of the 10-minute poll. -->
        <service
            android:name=".push.FirebaseService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
